<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>osmium</AssemblyName>
    <RootNamespace>Osmium.Cli</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Osmium.Core\Osmium.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- `osmium license` prints these, so the single-file executable carries its own notices. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Osmium.LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="Osmium.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
