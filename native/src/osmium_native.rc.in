// Version resource of osmium_native-<arch>.dll. Generated values come from CMakeLists.txt.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @OSN_VER_COMMA@
 PRODUCTVERSION @OSN_VER_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Osmium contributors"
            VALUE "FileDescription", "Osmium native encoders (@OSN_GEN_generation@)"
            VALUE "FileVersion", "@OSN_VERSION_DEFINE@"
            VALUE "InternalName", "osmium_native-@OSN_ARCH@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Osmium contributors. MIT. Contains the LZMA SDK (public domain) and Zstandard (BSD)."
            VALUE "OriginalFilename", "osmium_native-@OSN_ARCH@.dll"
            VALUE "ProductName", "Osmium"
            VALUE "ProductVersion", "@OSN_VERSION_DEFINE@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
