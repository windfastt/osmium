<Project Sdk="Microsoft.NET.Sdk">
  <!-- A small program the native-encoder tests run as a child process: the loader never unloads the library and
       chooses the encoders once per process, so cases that load a library from another folder, change the mode or
       count threads each get a fresh process. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Osmium.Core\Osmium.Core.csproj" />
  </ItemGroup>
</Project>
