<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Proto.Views"
        x:Class="Proto.Views.MainWindow"
        x:DataType="local:MainWindow"
        Classes="osmium"
        Title="Osmium" Width="1040" Height="760" MinWidth="900" MinHeight="600"
        Icon="avares://Proto.Views/Assets/osmium.ico">
  <Grid ColumnDefinitions="208,*" RowDefinitions="*,Auto">
    <!-- Navigation rail -->
    <Border Name="Rail" Grid.Column="0" Grid.Row="0" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,12">
        <!-- .brand: logo + wordmark (Anybody, 21px) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,2,0,22">
          <Viewbox Width="28" Height="28">
            <Canvas Width="32" Height="32">
              <Rectangle Canvas.Left="1.28" Canvas.Top="1.28" Width="29.44" Height="29.44" RadiusX="7.04" RadiusY="7.04">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#3a2a96" />
                    <GradientStop Offset="1" Color="#14a0d2" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Polygon Points="16,5.76 25.15,11.04 16,16.32 6.85,11.04" Fill="#f0f4ff" />
              <Polygon Points="25.15,11.04 25.15,21.6 16,26.88 16,16.32" Fill="#aab6d7" />
              <Polygon Points="6.85,11.04 16,16.32 16,26.88 6.85,21.6" Fill="#7884af" />
              <Polygon Points="16,12.16 19.6,14.24 16,16.32 12.4,14.24" Fill="#3c328c" />
              <Polygon Points="19.6,14.24 19.6,18.4 16,20.48 16,16.32" Fill="#286eaa" />
              <Polygon Points="12.4,14.24 16,16.32 16,20.48 12.4,18.4" Fill="#1e4682" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="Osmium" FontFamily="{StaticResource FontTitle}" FontSize="22" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="spec" Text="0.2.0 · UI PREVIEW" Margin="12,0,0,4" />
        <ListBox Name="Nav" Classes="rail" ItemsSource="{Binding NavItems}" SelectedIndex="0"
                 AutomationProperties.Name="Pages">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Classes="glyph" Data="{Binding Icon}" Stretch="None" StrokeThickness="1.4"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page host: Compress is built with the window; Archives and the placeholder are built on first visit. -->
    <Panel Name="PageHost" Grid.Column="1" Grid.Row="0">
      <local:CompressPage Name="Compress" />
    </Panel>

    <!-- Status line -->
    <Border Grid.ColumnSpan="2" Grid.Row="1" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0"
            Height="28" Padding="20,0">
      <TextBlock Name="Status" Classes="muted" FontSize="12.5" VerticalAlignment="Center"
                 Text="Analysing  ·  Profile: Ultra  ·  Worker: off  ·  preview: no real compression" />
    </Border>
  </Grid>
</Window>
